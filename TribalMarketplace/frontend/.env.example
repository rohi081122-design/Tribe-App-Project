# ---------------------------------------------------------------
# Tribal Marketplace - frontend environment variables
# Copy this file and name the copy ".env" (in this same folder).
# Only variables starting with VITE_ are visible to the React code.
# NEVER put secrets (MongoDB URL, Cloudinary secret, JWT secret) here -
# everything in the frontend can be seen by anyone who opens the website.
# ---------------------------------------------------------------

# Address of the backend API (no trailing slash)
VITE_API_URL=http://localhost:5000/api

# Address of the separate seller website (SellerTribe). The "Become a Seller" links open it.
VITE_SELLER_SITE_URL=http://localhost:5174
